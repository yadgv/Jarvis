# Jarvis settings template.
# Copy this file to ".env" in the same folder (next to config.py), then fill in the keys you have.
#   Windows:  copy .env.example .env
# Every line is optional unless it says otherwise. A blank value means "not set": Jarvis skips
# that feature (or uses its built-in default). .env is git-ignored, so your real keys never get
# committed. Don't put quotes around values unless the value itself has spaces.

# =====================================================================
# Brains (at least ONE of these is needed, or Jarvis can't think)
# Tried cheapest first, in BRAIN_ORDER in config.py: free ones first, Claude (paid) last.
# =====================================================================

# Groq: main free brain. RECOMMENDED. console.groq.com > API Keys > Create API Key (shown once).
GROQ_API_KEY=

# Cerebras: free, very fast backup. cloud.cerebras.ai > API Keys. Looks like csk-...
CEREBRAS_API_KEY=

# Google Gemini: free backup, and looks at pictures for free before Claude. aistudio.google.com/apikey. Looks like AIza...
GEMINI_API_KEY=

# Mistral: free backup. console.mistral.ai, pick the free "Experiment" plan first, then API Keys.
MISTRAL_API_KEY=

# GitHub Models: free backup. github.com/settings/personal-access-tokens > Generate new token
# (fine-grained), Permissions > Models: Read-only. Looks like github_pat_...
GITHUB_MODELS_TOKEN=

# OpenRouter: free backup when the others are busy. openrouter.ai/keys. Looks like sk-or-...
OPENROUTER_API_KEY=

# Claude: PAID, last resort only (Jarvis asks before using it). Also needed for screen control.
# console.anthropic.com > API Keys. Looks like sk-ant-...
ANTHROPIC_API_KEY=

# =====================================================================
# Voice
# =====================================================================

# Fish Audio (main voice). Already built into config.py, so leave this commented out.
# Only uncomment it to use a different key: fish.audio > API Keys.
# FISH_API_KEY=

# =====================================================================
# Browser
# =====================================================================

# Browser for links and searches: brave, chrome, edge or firefox. Blank = Windows' default browser.
JARVIS_BROWSER=

# =====================================================================
# Calendar
# =====================================================================

# Read-only calendar links (iCal / webcal://), separated by spaces. config.py already has your
# iCloud link built in, so leave this commented out unless you want different calendars.
# Google: Settings > your calendar > Integrate calendar > Secret address in iCal format.
# CALENDAR_ICS_URLS=

# Adding events to iCloud: your Apple ID email, and an app-specific password from
# appleid.apple.com > Sign-In and Security > App-Specific Passwords (looks like abcd-efgh-ijkl-mnop).
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Optional: which iCloud calendar to add to, by name (e.g. Home). Blank = the first one.
ICLOUD_CALENDAR=

# =====================================================================
# School (Canvas)
# =====================================================================

# Your school's Canvas address, e.g. learn.yourschool.ca (or just tell Jarvis "my Canvas is ...").
CANVAS_URL=
# Optional: Canvas > Calendar > Calendar Feed link, so "what's due" works without signing in.
CANVAS_CALENDAR_FEED=
# Optional: where class files are saved. Blank = Documents\School.
SCHOOL_FOLDER=

# =====================================================================
# Email (Gmail, read-only)
# =====================================================================

# Turn on 2-Step Verification, then make an app password at myaccount.google.com/apppasswords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# =====================================================================
# Phone (Telegram bot + alerts)
# =====================================================================

# In Telegram, message @BotFather, send /newbot, copy the token (looks like 123456:ABC...).
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID(s), comma-separated. Start Jarvis and message your bot: it replies with your ID.
TELEGRAM_ALLOWED_IDS=
# Optional free phone call before Approve/Deny questions: message @CallMeBot_txtbot once,
# then put your Telegram username here (e.g. @yourname).
CALLMEBOT_USER=
